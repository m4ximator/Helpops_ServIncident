@startuml
title Helpops_ServIncident V2 - ConsulterIncidentEnAttente
autonumber

actor Client
participant ServIncident
participant AuthService

group Consulter les tickets en attente (etat OPEN)
  Client -> ServIncident: consulterIncidentEnAttente(jeton)
  ServIncident -> AuthService: getLoginParJeton(jeton)
  AuthService --> ServIncident: nomAgent ou null
  ServIncident -> AuthService: getRoleParJeton(jeton)
  AuthService --> ServIncident: role ou null

  alt nomAgent != null et role == AGENT
    ServIncident -> ServIncident: ticketsEnAttente = new ArrayList<>()
    loop pour chaque incident de incidentEnBase
      alt "OPEN".equals(incident.getEtat())
        ServIncident -> ServIncident: ticketsEnAttente.add(incident)
      end
    end
    ServIncident --> Client: List<Incident> ticketsEnAttente (liste potentiellement vide)
  else jeton invalide ou role non AGENT
    ServIncident --> Client: null
  end
end
@enduml