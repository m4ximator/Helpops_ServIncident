@startuml
title Helpops_ServIncident V2 - ConsulterIncidentAgent
autonumber

actor Client
participant ServIncident
participant AuthService

group Consulter les tickets assignes a un agent
  Client -> ServIncident: consulterIncidentAgent(jeton)
  ServIncident -> AuthService: getLoginParJeton(jeton)
  AuthService --> ServIncident: nomAgent ou null
  ServIncident -> AuthService: getRoleParJeton(jeton)
  AuthService --> ServIncident: role ou null

  alt nomAgent != null et role == AGENT
    ServIncident -> ServIncident: ticketsAgent = new ArrayList<>()
    loop pour chaque incident de incidentEnBase
      alt incident.getAgentResponsable() != null\net incident.getAgentResponsable().equals(nomAgent)
        ServIncident -> ServIncident: ticketsAgent.add(incident)
      end
    end
    ServIncident --> Client: List<Incident> ticketsAgent (liste potentiellement vide)
  else jeton invalide ou role non AGENT
    ServIncident --> Client: null
  end
end
@enduml